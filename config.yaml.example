# FalkorDB Configuration (falkordb-litellm fork — replaces Neo4j)
falkor_host: localhost
falkor_port: 6379
# Unified graph — MUST match unified_group_id below (see memex/config.py's
# comment on why these two must always be identical).
falkor_graph: mem0-seed-local-verify

# LiteLLM gateway Configuration (OpenAI-compatible — replaces direct Gemini)
litellm_base_url: http://litellm.llm-gateway.svc.cluster.local:4000
litellm_api_key: your_litellm_key_here
litellm_model: mem0-extract-35b
# Grounded-synthesis model used by explain_change. Defaults to the same
# extraction model; override with a stronger gateway model if available.
pro_model: mem0-extract-35b

# Embedding — MUST match the model + dims the mem0 seed graph was built
# with, or vectors live in a different space and won't unify.
embedding_model: bge-m3
embedding_dim: 1024

# Unified graph — one group_id for all repos + the mem0 seed, so entities
# cross-link instead of being namespaced per-repo. MUST match falkor_graph.
unified_group_id: mem0-seed-local-verify

# Graphiti Configuration
log_level: INFO

# Harness configurations for different AI agents
# NOTE: this per-harness `initial_decision_confidence` config became LIVE in
# v0.7.0 Phase 01 — previously dead since it was authored in v0.6.0 "Signal"
# (see AUDIT.md finding V2), where every agent write silently resolved to the
# `default` entry regardless of the actual harness. Deployments with existing
# non-default `claude-code`/`gemini-cli` overrides will now see those values
# actually applied to newly-written Decision.base_confidence.
harnesses:
  gemini-cli:
    initial_decision_confidence: 0.6
    corroboration_window_days: 14
  claude-code:
    initial_decision_confidence: 0.7
    corroboration_window_days: 10
  default:
    initial_decision_confidence: 0.6
    corroboration_window_days: 14
